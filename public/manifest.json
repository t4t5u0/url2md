{
  "manifest_version": 3,
  "name": "url2md",
  "version": "0.2.0",
  "description": "現在のタブを Markdown リンク形式でクリップボードにコピーします",
  "minimum_chrome_version": "116",

  "icons": { "32": "icon_32.png" },

  "action": {
    "default_icon": { "32": "icon_32.png" },
    "default_title": "Copy as Markdown link"
  },

  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },

  "permissions": ["activeTab", "scripting"]
}
